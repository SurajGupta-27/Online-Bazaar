# Online Bazaar API settings. Copy this file to .env and fill in your own values.
# Never commit .env. Only MONGO_URL and JWT_SECRET are required; every other
# feature switches itself off cleanly when its keys are left empty, so leave a
# line empty until you have a real value for it.

# ---------------------------------------------------------------------------
# Core (required)
# ---------------------------------------------------------------------------

# MongoDB connection string (local MongoDB or a free MongoDB Atlas M0 cluster).
MONGO_URL=mongodb://127.0.0.1:27017/online-bazaar
# Long random string used to sign login tokens and unsubscribe links.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------

# Port the API listens on.
PORT=8080
# Label shown in the startup log line (development or production).
DEV_MODE=development
# Frontend origin(s) allowed by CORS, comma-separated. The first one is also
# used for links in emails (order pages, unsubscribe).
CLIENT_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Product images: Cloudinary (free plan)
# Without these, products can be saved without photos and uploads return 503.
# ---------------------------------------------------------------------------

# From the Cloudinary dashboard (API Keys page).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---------------------------------------------------------------------------
# Online payments: Razorpay (test mode keys work)
# Without these, checkout offers Cash on Delivery only.
# ---------------------------------------------------------------------------

# From Razorpay Dashboard > Account & Settings > API Keys (e.g. rzp_test_...).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# How long an unpaid online order holds its stock, in seconds (default 900).
PAYMENT_HOLD_SECONDS=900
# How often expired holds are released, in seconds (default 60).
PAYMENT_SWEEP_SECONDS=60

# ---------------------------------------------------------------------------
# Google Sign-In (Google Cloud OAuth client ID, type "Web application")
# Use the same value as REACT_APP_GOOGLE_CLIENT_ID in client/.env.
# Without it the "Continue with Google" button is hidden.
# ---------------------------------------------------------------------------

# e.g. 1234567890-abc123.apps.googleusercontent.com
GOOGLE_CLIENT_ID=

# ---------------------------------------------------------------------------
# Email: order confirmations, invoices, tracking updates and alerts (Gmail SMTP)
# EMAIL_APP_PASSWORD is a Gmail App Password (needs 2-Step Verification),
# not your normal Gmail password. Without these, emails are skipped.
# ---------------------------------------------------------------------------

# e.g. yourstore@gmail.com
EMAIL_USER=
EMAIL_APP_PASSWORD=

# ---------------------------------------------------------------------------
# Price-drop and back-in-stock alerts (optional tuning; defaults shown)
# ---------------------------------------------------------------------------

# Alert emails sent per batch.
ALERT_BATCH_SIZE=20
# Pause between batches, in seconds.
ALERT_BATCH_PAUSE_SECONDS=5
# Most alert emails per rolling 24 hours (kept below Gmail's ~500/day limit).
ALERT_DAILY_LIMIT=300
# How often the alert queue is checked, in seconds.
ALERT_SWEEP_SECONDS=300

# ---------------------------------------------------------------------------
# Shopping assistant ("Ask Bazaar AI")
# AI_PROVIDER: gemini, groq or none. With none, or without the matching key,
# the assistant answers with rule-based smart search.
# ---------------------------------------------------------------------------

AI_PROVIDER=none
# Google AI Studio key (free tier), used when AI_PROVIDER=gemini.
GEMINI_API_KEY=
# Optional: model name (default gemini-3.5-flash-lite).
GEMINI_MODEL=
# Optional: Gemini thinking level (leave empty for the model's default).
GEMINI_THINKING_LEVEL=
# Groq key (free tier), used when AI_PROVIDER=groq.
GROQ_API_KEY=
# Optional: model name (default llama-3.3-70b-versatile).
GROQ_MODEL=
# Give up on the AI and use smart search after this many milliseconds.
AI_TIMEOUT_MS=10000
# Pause after a 429 (rate limit) without Retry-After, in seconds.
AI_COOLDOWN_SECONDS=60
# Most AI requests per server per 24 hours; smart search answers after that.
AI_DAILY_LIMIT=900
# Assistant messages allowed per account (or IP when logged out).
ASSISTANT_LIMIT_PER_MINUTE=8
ASSISTANT_LIMIT_PER_DAY=150

# ---------------------------------------------------------------------------
# Seeding (npm run seed:dummyjson)
# ---------------------------------------------------------------------------

# USD to INR rate used when importing DummyJSON prices (default 85).
USD_TO_INR=85
