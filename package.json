{
  "name": "online-bazaar",
  "version": "1.0.0",
  "description": "Online Bazaar: a MERN e-commerce store with an AI shopping assistant, order tracking, price-drop alerts, reviews and Razorpay payments",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "server": "nodemon server.js",
    "client": "npm start --prefix ./client",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "test": "node tests/run.mjs",
    "migrate:photos": "node scripts/migratePhotosToCloudinary.mjs",
    "seed:dummyjson": "node scripts/seedDummyJson.mjs",
    "remove:categories": "node scripts/removeCategories.mjs",
    "merge:categories": "node scripts/mergeCategories.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SurajGupta-27/E-commerce-Web.git"
  },
  "keywords": [
    "mern",
    "ecommerce",
    "react",
    "express",
    "mongodb",
    "razorpay",
    "gemini"
  ],
  "author": "Suraj Gupta",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/SurajGupta-27/E-commerce-Web/issues"
  },
  "homepage": "https://github.com/SurajGupta-27/E-commerce-Web#readme",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "colors": "^1.4.0",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "express-formidable": "^1.2.0",
    "express-rate-limit": "^8.7.0",
    "google-auth-library": "^11.3.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.1.5",
    "morgan": "^1.10.1",
    "nodemailer": "^10.1.7",
    "pdfkit": "^0.20.2",
    "slugify": "^1.6.6"
  },
  "devDependencies": {
    "concurrently": "^9.2.5",
    "mongodb-memory-server": "^11.3.0",
    "nodemon": "^3.1.14"
  }
}
