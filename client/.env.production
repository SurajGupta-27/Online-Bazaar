# Committed build settings for `npm run build` (no secrets: everything here is
# public). REACT_APP_* values such as REACT_APP_GOOGLE_CLIENT_ID come from the
# host's environment variables or client/.env.
# Keep the runtime script out of index.html so the server's Content Security
# Policy (no inline scripts) allows the page.
INLINE_RUNTIME_CHUNK=false
# Don't publish source maps.
GENERATE_SOURCEMAP=false
