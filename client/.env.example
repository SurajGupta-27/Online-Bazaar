# Online Bazaar frontend settings. Copy this file to client/.env.
# Create React App only exposes variables starting with REACT_APP_, and their
# values end up in the public JavaScript bundle, so never put secrets here.

# Google OAuth client ID (the same value as GOOGLE_CLIENT_ID in the root .env).
# e.g. 1234567890-abc123.apps.googleusercontent.com. Leave empty to hide the "Continue with Google" button.
REACT_APP_GOOGLE_CLIENT_ID=

# Where the API lives, when the frontend is hosted apart from it (Vercel +
# Render), e.g. https://online-bazaar-api.onrender.com (no trailing slash).
# Leave empty locally (the dev server proxies /api to localhost:8080) and when
# Express serves this build itself. Built into the bundle: rebuild after changing it.
REACT_APP_API_URL=
